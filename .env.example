# StoryForge AI Environment Variables
# Copy this file to .env.local and add your Google Gemini API key:
# cp .env.example .env.local

# Google Gemini API Key (Required for server-side story generation)
# Get your free key at: https://aistudio.google.com/
# SECURITY WARNING: Never add NEXT_PUBLIC_ prefix to this key!
GEMINI_API_KEY=your_gemini_api_key_here
